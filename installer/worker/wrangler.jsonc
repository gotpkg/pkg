{
    // The stub that serves gotpkg.dev until the site's Worker takes the domain over: delete this
    // Worker (`wrangler delete --name gotpkg-dev`) once the site serves both installer routes.
    // `mise run installer:worker:deploy` deploys it.
    "name": "gotpkg-dev",
    "main": "worker.js",
    "compatibility_date": "2026-11-10",
    "workers_dev": false,
    "routes": [{ "pattern": "gotpkg.dev", "custom_domain": true }],
}
