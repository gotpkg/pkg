# The environment pkg's repository and binary read. Varlock loads this schema for credentialed
# tasks (`mise run release` runs `varlock run --filter GITHUB_TOKEN -- knope release`, loading only
# that item). Values come from the process environment (in CI, a job's `env:`) or a gitignored
# .env.local; never commit a value. `mise run check` reads none of these.
#
# GitHub Actions credentials: release.yml's `release` job passes the built-in GITHUB_TOKEN (no
# stored secret). HOMEBREW_TAP_TOKEN is not read by any task: it lives in the `homebrew` GitHub
# environment (restricted to `main`), only release.yml's `homebrew` job declares that
# environment, and the repository variable HOMEBREW_TAP = `true` turns that job on.
# @defaultSensitive=false @defaultRequired=false
# ---

# GitHub token `knope release` uses to tag the release and publish it with its archives. In
# release.yml this is the workflow's built-in GITHUB_TOKEN, with `contents: write` on that job
# only; `mise run release` fails without it.
# @sensitive @required @type=string
GITHUB_TOKEN=

# The mise executable the pkg binary runs. Unset means `mise` on PATH (see `pkg context show`).
# @type=string
PKG_MISE=

# The base URL of Homebrew's formula and cask API. Unset means https://formulae.brew.sh/api.
# @type=string
PKG_HOMEBREW_API=

# The base URL of Apple's iTunes Search API, for `mas:` apps. Unset means https://itunes.apple.com.
# @type=string
PKG_APP_STORE_API=
