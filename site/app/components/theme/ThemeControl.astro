<label class="theme-control" title="Color theme">
    <span class="sr-only">Select theme</span>
    <svg
        aria-hidden="true"
        class="theme-icon theme-auto"
        fill="none"
        height="20"
        stroke="currentColor"
        stroke-width="1.6"
        viewBox="0 0 24 24"
        width="20"
    >
        <rect height="13" rx="2" width="18" x="3" y="4" />
        <path d="M8 21h8m-4-4v4" />
    </svg>
    <svg
        aria-hidden="true"
        class="theme-icon theme-light"
        fill="none"
        height="20"
        stroke="currentColor"
        stroke-width="1.6"
        viewBox="0 0 24 24"
        width="20"
    >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg
        aria-hidden="true"
        class="theme-icon theme-dark"
        fill="none"
        height="20"
        stroke="currentColor"
        stroke-width="1.6"
        viewBox="0 0 24 24"
        width="20"
    >
        <path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A9 9 0 1 0 20.5 14Z" />
    </svg>
    <select data-theme-select disabled>
        <option selected value="auto">Auto</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
    </select>
</label>

<style>
    .theme-control {
        position: relative;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
    }
    .theme-control:hover {
        background: var(--control-hover);
    }
    .theme-control:focus-within {
        outline: 3px solid var(--focus);
        outline-offset: 3px;
    }
    .theme-control:has(select:disabled) {
        opacity: 0.5;
    }
    select {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        font: inherit;
    }
    select:disabled {
        cursor: default;
    }
    .theme-control:has([value="dark"]:not(:checked)) .theme-dark,
    .theme-control:has([value="light"]:not(:checked)) .theme-light,
    .theme-control:has([value="auto"]:not(:checked)) .theme-auto {
        display: none;
    }
</style>
