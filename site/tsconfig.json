{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        // Mirrors `imports` in package.json, which Node, Vite and Playwright resolve.
        "paths": {
            "#/*": ["./app/*"]
        }
    }
}
