{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Astro supplies the built entrypoint and assets directory when it writes the deploy config.
    "name": "pkg-site",
    "main": "./app/worker.js",
    "compatibility_date": "2026-11-10",
    "workers_dev": true,
    "routes": [{ "pattern": "gotpkg.dev", "custom_domain": true }],
    "assets": {
        "run_worker_first": ["/", "/install.sh"],
        // Unknown paths get the prerendered 404 page with a 404 status.
        "not_found_handling": "404-page",
        // Prerendered pages are `<route>/index.html`. The default, `auto-trailing-slash`, would
        // answer `/docs/install` with a 307 to `/docs/install/`; canonical URLs are unslashed
        // (`trailingSlash: "never"` in astro.config.ts), so slashed requests redirect instead.
        "html_handling": "drop-trailing-slash",
    },
}
